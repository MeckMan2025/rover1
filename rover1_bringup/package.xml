<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover1_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and configuration for Rover1</description>
  <maintainer email="andrew@example.com">Andrew Meckley</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rover1_hardware</depend>
  <depend>rover1_control</depend>
  
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ublox_dgnss</exec_depend>
  <exec_depend>ntrip_client</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rover1_description</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <!-- RTAB-Map for Indoor SLAM (Phase 6) -->
  <exec_depend>rtabmap_ros</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>

  <!-- Nav2 for Autonomous Navigation (Phase 6) -->
  <!-- CycloneDDS avoids FastRTPS shared memory issues on Pi 5 -->
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
