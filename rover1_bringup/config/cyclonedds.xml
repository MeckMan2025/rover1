<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <Internal>
      <!-- Combine multiple participants into fewer underlying DDS participants -->
      <!-- This is the key fix for "Failed to find a free participant index" -->
      <SquashParticipants>true</SquashParticipants>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
