<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration to pin DDS traffic to wlan0 only.

  Problem: Without explicit interface binding, CycloneDDS joins multicast
  groups on ALL interfaces (wlan0 + tailscale0), causing:
  - DDS traffic split across interfaces
  - Intermittent discovery failures
  - Jerky teleop due to packet loss

  Solution: Explicitly bind to wlan0 only.

  Usage: Set CYCLONEDDS_URI=file:///path/to/cyclonedds_wlan0.xml
-->
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain>
        <General>
            <Interfaces>
                <NetworkInterface name="wlan0" priority="default" multicast="true" />
            </Interfaces>
            <!-- Increase participant limit for complex launch -->
            <MaxParticipants>120</MaxParticipants>
        </General>
        <Tracing>
            <Verbosity>warning</Verbosity>
        </Tracing>
    </Domain>
</CycloneDDS>
