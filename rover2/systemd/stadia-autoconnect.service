[Unit]
Description=Stadia Controller Auto-Connect Daemon
Documentation=https://github.com/MeckMan2025/rover1
After=bluetooth.service
Wants=bluetooth.service
BindsTo=bluetooth.service

[Service]
Type=simple
ExecStart=/home/andrewmeckley/ros2_ws/src/rover1/scripts/stadia_autoconnect.sh
Restart=on-failure
RestartSec=5
User=andrewmeckley
Group=andrewmeckley

# Environment
Environment=PATH=/usr/bin:/bin:/usr/sbin:/sbin

# Timeout settings
TimeoutStartSec=30
TimeoutStopSec=10

# Send SIGTERM for graceful shutdown
KillMode=mixed
KillSignal=SIGTERM

# Security settings (relaxed to allow bluetooth access)
NoNewPrivileges=yes
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stadia-autoconnect

[Install]
WantedBy=multi-user.target
