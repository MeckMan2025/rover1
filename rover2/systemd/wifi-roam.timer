[Unit]
Description=WiFi Roaming Check Timer for Rover1
Documentation=https://github.com/MeckMan2025/rover1

[Timer]
# Run 60 seconds after boot
OnBootSec=60
# Then every 60 seconds
OnUnitActiveSec=60
# Add randomized delay to prevent thundering herd
RandomizedDelaySec=5
# Persist timer across reboots
Persistent=true

[Install]
WantedBy=timers.target
