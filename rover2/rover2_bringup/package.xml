<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover2_bringup</name>
  <version>1.0.0</version>
  <description>Pack Robot bringup - minimal launch configuration</description>
  <maintainer email="andrew.meckley@example.com">Andrew Meckley</maintainer>
  <license>MIT</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>rover2_hardware</depend>
  <depend>rover2_vision</depend>
  <depend>rover2_dashboard</depend>
  <depend>ascamera</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>