[Unit]
Description=WiFi Roaming Check for Rover1
Documentation=https://github.com/MeckMan2025/rover1
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wifi-roam.sh
# Don't restart on failure - timer will trigger next run
Restart=no
# Timeout for scan + connection attempt
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
