[Unit]
Description=Rover FastAPI dashboard (drive + camera)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/ros2_ws/src/rover1
Environment=ROVER_CAM_GAIN=3
ExecStart=%h/code/rover1-venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
# Camera init can take a moment after USB power-up; allow a few retries.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=default.target
