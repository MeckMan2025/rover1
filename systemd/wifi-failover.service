[Unit]
Description=Rover1 WiFi failover (STA priority + AP fallback)
Documentation=https://github.com/MeckMan2025/rover1
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wifi-failover.sh
Restart=no
# Brief AP-drop + scan + nmcli up can take ~10 s in the worst case.
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
