[Unit]
Description=Rover Kiosk Mode - Fullscreen Dashboard on Touchscreen
After=rover1.service graphical.target
Wants=rover1.service
PartOf=rover1.service

[Service]
Type=simple
User=andrewmeckley
Group=andrewmeckley

# Wayland/Cage environment
Environment="WLR_LIBINPUT_NO_DEVICES=1"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="HOME=/home/andrewmeckley"

# Use Cage as lightweight Wayland kiosk compositor
# Cage runs a single application fullscreen with no window decorations
ExecStart=/usr/bin/cage /home/andrewmeckley/.config/rover-kiosk/launch-kiosk.sh

# Restart on failure, but with delay to allow dashboard to come up
Restart=on-failure
RestartSec=10

# Stop kiosk if rover1 service stops
BindsTo=rover1.service

[Install]
WantedBy=graphical.target
